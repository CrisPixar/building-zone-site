# Кеширование для Cloudflare Pages (файл читается хостингом автоматически).
# Шрифты встроены прямо в index.html (см. scripts/build-fonts.mjs), поэтому
# правил для /fonts/ больше нет.
# Фото меняются под теми же именами, поэтому умеренный max-age + stale-while-revalidate.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
